{% assign local_ts = "now" | date: "%s" | plus: trmnl.user.utc_offset %}
{% assign mmdd = local_ts | date: "%m-%d" %}
{% assign nice_date = local_ts | date: "%B %-d" %}
{% assign entry = days[mmdd] %}

{% if entry %}
<div class="layout layout--center">
  {% if entry.orientation == "landscape" %}{% assign dir = "flex--col" %}{% else %}{% assign dir = "flex--row portrait:flex--col" %}{% endif %}
  {% if entry.orientation == "landscape" %}{% assign tw = "w--[92cqw]" %}{% else %}{% assign tw = "w--[48cqw] portrait:w--[92cqw]" %}{% endif %}
  <div class="flex {{ dir }} flex--center gap--medium text--center">
    {% if entry.orientation == "landscape" %}
      <img class="image image-dither image--contain
                  w--[88cqw] h--auto h--max-[64cqh]
                  portrait:h--max-[46cqh]"
           src="{{ entry.image }}" alt="{{ entry.title }}" />
    {% else %}
      <img class="image image-dither image--contain landscape:flex-none
                  h--[92cqh] w--auto w--max-[46cqw]
                  portrait:h--[60cqh] portrait:w--max-[80cqw]"
           src="{{ entry.image }}" alt="{{ entry.title }}" />
    {% endif %}
    <div class="flex flex--col flex--center gap--small {{ tw }}">
      <span class="label label--base lg:label--large label--underline">{{ entry.category | upcase }} &bull; {{ entry.year }}</span>
      <span class="value value--base portrait:value--small lg:value--large lg:portrait:value--base"
            data-clamp="4">{{ entry.title }}</span>
    </div>
  </div>
</div>
{% else %}
<div class="layout layout--center">
  <span class="value value--large lg:value--xlarge">The archive is silent today&hellip;</span>
</div>
{% endif %}

<div class="title_bar">
  <img class="image" src="data:image/svg+xml;base64," />
  <span class="title">This Day in Horror</span>
  <span class="instance">{{ nice_date }}</span>
</div>
