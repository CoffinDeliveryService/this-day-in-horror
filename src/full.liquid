{% assign local_ts = "now" | date: "%s" | plus: trmnl.user.utc_offset %}
{% assign mmdd = local_ts | date: "%m-%d" %}
{% assign nice_date = local_ts | date: "%B %-d" %}
{% assign entry = days[mmdd] %}

{% if entry %}
<div class="layout layout--center">
  <div class="flex flex--row flex--center gap--large portrait:flex--col lg:portrait:flex--col">
    <img class="image image-dither image--contain flex-none
                w--56 lg:w--[50cqw] h--80 lg:h--auto
                lg:h--max-[70cqh] lg:portrait:h--max-[40cqh]"
         src="{{ entry.image }}" alt="{{ entry.title }}" />
    <div class="flex flex--col gap--small">
      <span class="label label--base label--underline lg:label--xlarge">{{ entry.category | upcase }} &bull; {{ entry.year }}</span>
      <span class="value value--large lg:value--xlarge" data-clamp="2">{{ entry.title }}</span>
      <p class="description description--base lg:description--large" data-clamp="2" data-clamp-lg="4">{{ entry.fact }}</p>
    </div>
  </div>
</div>
{% else %}
<div class="layout layout--center">
  <span class="value value--large lg:value--xxlarge">The archive is silent today&hellip;</span>
</div>
{% endif %}

<div class="title_bar">
  <img class="image" src="data:image/svg+xml;base64," />
  <span class="title">This Day in Horror</span>
  <span class="instance">{{ nice_date }}</span>
</div>
