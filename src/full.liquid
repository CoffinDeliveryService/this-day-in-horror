{% assign local_ts = "now" | date: "%s" | plus: trmnl.user.utc_offset %}
{% assign mmdd = local_ts | date: "%m-%d" %}
{% assign nice_date = local_ts | date: "%B %-d" %}
{% assign entry = days[mmdd] %}

{% if entry %}
<div class="layout layout--center">
  <div class="flex {% if entry.orientation == "landscape" %}flex--col{% else %}flex--row{% endif %} flex--center gap--large lg:portrait:flex--col">
    {% if entry.orientation == "landscape" %}
      {% comment %} Wide stills stack above the text so they can use the full width {% endcomment %}
      <img class="image image-dither image--contain flex-none
                  w--[72cqw] lg:w--[68cqw] h--auto
                  h--max-[62cqh] lg:h--max-[58cqh] lg:portrait:h--max-[40cqh]"
           src="{{ entry.image }}" alt="{{ entry.title }}" />
    {% else %}
      {% comment %} Posters sit beside the text, driven from height {% endcomment %}
      <img class="image image-dither image--contain flex-none
                  h--[88cqh] lg:h--[85cqh] w--auto
                  w--max-[42cqw] lg:w--max-[45cqw] lg:portrait:h--max-[45cqh]"
           src="{{ entry.image }}" alt="{{ entry.title }}" />
    {% endif %}
    <div class="flex flex--col flex--center gap--small text--center">
      <span class="label label--large label--underline lg:label--xlarge">{{ entry.category | upcase }} &bull; {{ entry.year }}</span>
      <span class="value lg:value--xxlarge" data-clamp="3">{{ entry.title }}</span>
    </div>
  </div>
</div>
{% else %}
<div class="layout layout--center">
  <span class="value value--large lg:value--xxlarge">The archive is silent today&hellip;</span>
</div>
{% endif %}

<div class="title_bar">
  <img class="image" src="data:image/svg+xml;base64," />
  <span class="title">This Day in Horror</span>
  <span class="instance">{{ nice_date }}</span>
</div>
