{% assign local_ts = "now" | date: "%s" | plus: trmnl.user.utc_offset %}
{% assign mmdd = local_ts | date: "%m-%d" %}
{% assign entry = days[mmdd] %}

{% if entry %}
<div class="layout layout--center">
  <div class="flex flex--col gap--xsmall">
    <span class="label label--small lg:label--large">THIS DAY IN HORROR &bull; {{ entry.year }}</span>
    <span class="value lg:value--large">{{ entry.title }}</span>
    <p class="description lg:description--large" data-clamp="3" data-clamp-lg="4" data-clamp-lg-portrait="4">{{ entry.fact }}</p>
  </div>
</div>
{% else %}
<div class="layout layout--center"><span class="value lg:value--large">&hellip;</span></div>
{% endif %}
