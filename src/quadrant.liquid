{% assign local_ts = "now" | date: "%s" | plus: trmnl.user.utc_offset %}
{% assign mmdd = local_ts | date: "%m-%d" %}
{% assign nice_date = local_ts | date: "%b %-d" %}
{% assign entry = days[mmdd] %}

{% if entry %}
<div class="layout layout--center">
  {% if entry.orientation == "landscape" %}
    {% assign dir = "flex--col" %}
  {% else %}
    {% assign dir = "flex--row portrait:flex--col" %}
  {% endif %}
  <div class="flex {{ dir }} flex--center gap--xsmall text--center">
    {% if entry.orientation == "landscape" %}
      <img class="image image-dither image--contain
                  w--[92cqw] h--auto h--max-[62cqh]
                  portrait:h--max-[50cqh]"
           src="{{ entry.image }}" alt="{{ entry.title }}" />
    {% else %}
      <img class="image image-dither image--contain landscape:flex-none
                  h--[92cqh] w--auto w--max-[42cqw]
                  portrait:h--[64cqh] portrait:w--max-[70cqw]"
           src="{{ entry.image }}" alt="{{ entry.title }}" />
    {% endif %}
    <div class="flex flex--col flex--center gap--xsmall {% if entry.orientation == "landscape" %}w--[94cqw]{% else %}w--[50cqw] portrait:w--[94cqw]{% endif %}">
      <span class="label label--small lg:label--base">{{ entry.category | upcase }} &bull; {{ entry.year }}</span>
      <span class="value value--xsmall portrait:value--xsmall lg:value--base lg:portrait:value--small"
            data-clamp="4">{{ entry.title }}</span>
    </div>
  </div>
</div>
{% else %}
<div class="layout layout--center"><span class="value value--xsmall lg:value--base">&hellip;</span></div>
{% endif %}

<div class="title_bar">
  <img class="image" src="data:image/svg+xml;base64," />
  <span class="title">This Day in Horror</span>
  <span class="instance">{{ nice_date }}</span>
</div>
