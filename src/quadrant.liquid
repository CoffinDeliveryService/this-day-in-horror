{% assign local_ts = "now" | date: "%s" | plus: trmnl.user.utc_offset %}
{% assign mmdd = local_ts | date: "%m-%d" %}
{% assign entry = days[mmdd] %}

{% if entry %}
<div class="layout layout--center">
  <div class="flex flex--col gap--xsmall">
    <span class="label label--small">THIS DAY IN HORROR &bull; {{ entry.year }}</span>
    <span class="value lg:value--large">{{ entry.title }}</span>
    <p class="description">{{ entry.fact | truncate: 100 }}</p>
  </div>
</div>
{% else %}
<div class="layout layout--center"><span class="value">&hellip;</span></div>
{% endif %}
