{% assign local_ts = "now" | date: "%s" | plus: trmnl.user.utc_offset %}
{% assign mmdd = local_ts | date: "%m-%d" %}
{% assign entry = days[mmdd] %}

{% if entry %}
<div class="layout layout--center">
  <div class="flex flex--col lg:flex--row lg:portrait:flex--col flex--center gap--xsmall text--center">
      <img class="hidden lg:visible image image-dither image--contain flex-none
                  w--[64cqw] lg:w--[46cqw] h--auto
                  h--max-[50cqh] lg:h--max-[58cqh]"
           src="{{ entry.image }}" alt="{{ entry.title }}" />
    <div class="flex flex--col">
      <span class="label label--base lg:label--large">{{ entry.category | upcase }} &bull; {{ entry.year }}</span>
      <span class="value lg:value--large" data-clamp="3">{{ entry.title }}</span>
    </div>
  </div>
</div>
{% else %}
<div class="layout layout--center"><span class="value lg:value--large">&hellip;</span></div>
{% endif %}
