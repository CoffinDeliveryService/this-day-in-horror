{% assign local_ts = "now" | date: "%s" | plus: trmnl.user.utc_offset %}
{% assign mmdd = local_ts | date: "%m-%d" %}
{% assign nice_date = local_ts | date: "%b %-d" %}
{% assign entry = days[mmdd] %}

{% if entry %}
<div class="layout layout--center">
  <div class="flex flex--col flex--center gap--small text--center">
    {% if entry.orientation == "landscape" %}
      <img class="image image-dither image--contain
                  w--[94cqw] h--auto h--max-[46cqh]"
           src="{{ entry.image }}" alt="{{ entry.title }}" />
    {% else %}
      <img class="image image-dither image--contain
                  h--[64cqh] w--auto w--max-[92cqw]
                  portrait:h--max-[56cqh]"
           src="{{ entry.image }}" alt="{{ entry.title }}" />
    {% endif %}
    <span class="label label--base lg:label--large">{{ entry.category | upcase }} &bull; {{ entry.year }}</span>
    <span class="value value--small portrait:value--xsmall lg:value--base lg:portrait:value--small" data-clamp="4">{{ entry.title }}</span>
  </div>
</div>
{% else %}
<div class="layout layout--center"><span class="value value--small portrait:value--xsmall lg:value--base lg:portrait:value--small">The archive is silent today&hellip;</span></div>
{% endif %}

<div class="title_bar">
  <span class="title">This Day in Horror</span>
  <span class="instance">{{ nice_date }}</span>
</div>
