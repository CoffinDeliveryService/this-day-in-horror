{% assign local_ts = "now" | date: "%s" | plus: trmnl.user.utc_offset %}
{% assign mmdd = local_ts | date: "%m-%d" %}
{% assign nice_date = local_ts | date: "%b %-d" %}
{% assign entry = days[mmdd] %}

{% if entry %}
<div class="layout layout--col" style="align-items: center; text-align: center; gap: 8px; padding: 0 10px;">
  <img class="image image-dither" src="{{ entry.image }}" style="max-height: 200px; max-width: 90%; object-fit: contain;" />
  <span class="label label--small">{{ entry.category | upcase }} &bull; {{ entry.year }}</span>
  <span class="value value--large">{{ entry.title }}</span>
  <p class="description" style="font-size: 15px; line-height: 1.35;">{{ entry.fact | truncate: 140 }}</p>
</div>
{% else %}
<div class="layout"><span class="value">The archive is silent today&hellip;</span></div>
{% endif %}

<div class="title_bar">
  <img class="image" src="https://usetrmnl.com/images/plugins/trmnl--render.svg" />
  <span class="title">This Day in Horror</span>
  <span class="instance">{{ nice_date }}</span>
</div>
